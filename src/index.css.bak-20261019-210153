:root {
  --green-900: #163a2b;
  --green-800: #1f4d3a;
  --green-600: #2f7a58;
  --green-100: #e3efe8;
  --ochre: #c8862a;
  --ochre-100: #f8ecd6;
  --bg: #f6f2e9;
  --surface: #ffffff;
  --text: #22291f;
  --muted: #6b7266;
  --line: #e2dccd;
  --bad: #b3372b;
  --bad-100: #f9e1dd;
  --warn-100: #fbefcf;
  --info: #25628f;
  --info-100: #dcebf6;
  --radius: 10px;
  font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  color: var(--text);
  background: var(--bg);
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #131a15; --surface: #1b241e; --text: #e8ece4; --muted: #9aa393; --line: #2c382f;
    --green-100: #22352a; --ochre-100: #3a2e18; --bad-100: #3d1f1b; --warn-100: #3a3016; --info-100: #1b3243;
    --green-800: #2f7a58; --green-900: #0f1e16;
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); }
h1, h2, h3 { font-family: Georgia, 'Times New Roman', serif; margin: 0; font-weight: 600; }
h1 { font-size: 1.7rem; }
h2 { font-size: 1.2rem; }
a { color: var(--green-600); }
.muted { color: var(--muted); font-size: .9rem; margin: .2rem 0 0; }
.empty { color: var(--muted); padding: 1.5rem; text-align: center; }

/* Layout */
.shell { display: grid; grid-template-columns: 250px 1fr; min-height: 100vh; min-height: 100dvh; }
.sidebar { background: var(--green-900); color: #e9efe9; padding: 1.2rem 1rem; display: flex; flex-direction: column; gap: 1rem; position: sticky; top: 0; height: 100vh; height: 100dvh; overflow-y: auto; }
.brand { display: flex; align-items: center; gap: .6rem; font-family: Georgia, serif; font-size: 1.3rem; padding: 0 .4rem; }
.brand small { display: block; font-family: system-ui, sans-serif; font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; color: #9fb8aa; }
.brand img { width: 34px; height: 34px; }
.org-select { width: 100%; background: var(--side-field, #0f2a1f); color: #fff; border: 1px solid var(--side-line, #2c5a45); border-radius: 8px; padding: .5rem; }
.nav-title { font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; color: #8fae9e; margin: .8rem .4rem .2rem; }
.nav a { display: block; color: #dbe6de; text-decoration: none; padding: .5rem .7rem; border-radius: 8px; }
.nav a:hover { background: var(--side-hover, #21503c); }
.nav a.active { background: var(--ochre); color: var(--on-ochre, #1d1608); font-weight: 600; }
.sidebar-foot { margin-top: auto; font-size: .85rem; color: #b9cbbf; padding: .4rem; }
.sidebar-foot button { margin-top: .5rem; }
.main { padding: 1.8rem clamp(1rem, 3vw, 2.5rem); max-width: 1200px; width: 100%; }
.menu-toggle { display: none; }
@media (max-width: 860px) {
  .shell { grid-template-columns: 1fr; }
  .sidebar { position: fixed; z-index: 20; width: 260px; transform: translateX(-100%); transition: transform .2s; }
  .sidebar.open { transform: none; }
  .menu-toggle { display: inline-flex; margin-bottom: 1rem; }
}

/* Header */
.page-header { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.2rem; }
.page-actions { display: flex; gap: .5rem; flex-wrap: wrap; }

/* Cards, tables */
.card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.1rem; }
.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: .9rem; margin-bottom: 1.4rem; }
.stat .num { font-family: Georgia, serif; font-size: 2rem; color: var(--green-800); line-height: 1.1; }
.stat .lbl { color: var(--muted); font-size: .85rem; }
.stat.warn .num { color: var(--bad); }
.table-wrap { overflow-x: auto; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
table { width: 100%; border-collapse: collapse; font-size: .92rem; }
th { text-align: left; font-size: .75rem; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); padding: .7rem .9rem; border-bottom: 1px solid var(--line); white-space: nowrap; }
td { padding: .65rem .9rem; border-bottom: 1px solid var(--line); vertical-align: middle; }
tr:last-child td { border-bottom: 0; }
td.actions { white-space: nowrap; text-align: right; }
.section { margin-top: 1.6rem; }
.section > h2 { margin-bottom: .7rem; }

/* Forms */
.toolbar { display: flex; gap: .6rem; flex-wrap: wrap; margin-bottom: 1rem; align-items: center; }
input, select, textarea { font: inherit; color: inherit; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: .55rem .7rem; min-width: 0; }
input:focus, select:focus, textarea:focus { outline: 2px solid var(--green-600); outline-offset: -1px; }
.toolbar input[type='search'] { flex: 1; min-width: 200px; }
.field { display: flex; flex-direction: column; gap: .25rem; margin-bottom: .8rem; font-size: .9rem; }
.field > span { font-weight: 600; }
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 .8rem; }
@media (max-width: 560px) { .form-grid { grid-template-columns: 1fr; } }
.form-actions { display: flex; justify-content: flex-end; gap: .5rem; margin-top: .6rem; }
.check { flex-direction: row; align-items: center; gap: .5rem; }

/* Buttons */
.btn { font: inherit; cursor: pointer; border: 1px solid transparent; border-radius: 8px; padding: .5rem .9rem; background: var(--green-800); color: #fff; font-weight: 600; }
.btn:hover:not(:disabled) { filter: brightness(1.12); }
.btn:disabled { opacity: .5; cursor: not-allowed; }
.btn-ghost { background: transparent; color: var(--green-600); border-color: var(--line); padding: .35rem .7rem; font-weight: 500; }
.btn-ochre { background: var(--ochre); color: var(--on-ochre, #1d1608); }
.btn-danger { background: var(--bad); }
.btn-sm { padding: .3rem .6rem; font-size: .82rem; }
.sidebar .btn-ghost { color: #dbe6de; border-color: var(--side-line, #2c5a45); }
.icon-btn { background: none; border: 0; font-size: 1.6rem; cursor: pointer; color: var(--muted); line-height: 1; }

/* Badges, alerts */
.badge { display: inline-block; padding: .15rem .55rem; border-radius: 999px; font-size: .75rem; font-weight: 600; white-space: nowrap; }
.badge-ok { background: var(--green-100); color: var(--green-800); }
.badge-info { background: var(--info-100); color: var(--info); }
.badge-warn { background: var(--warn-100); color: #8a5a00; }
.badge-bad { background: var(--bad-100); color: var(--bad); }
.badge-neutral { background: var(--line); color: var(--muted); }
.alert { padding: .7rem .9rem; border-radius: 8px; margin: .6rem 0; font-size: .92rem; }
.alert-error { background: var(--bad-100); color: var(--bad); }
.alert-ok { background: var(--green-100); color: var(--green-800); }
.alert-info { background: var(--ochre-100); color: #6d4a10; }

/* Modal */
.modal-backdrop { position: fixed; inset: 0; background: rgba(10, 20, 14, .5); display: grid; place-items: center; z-index: 50; padding: 1rem; }
.modal { background: var(--surface); border-radius: 14px; padding: 1.3rem; width: min(480px, 100%); max-height: 90vh; overflow-y: auto; }
.modal-wide { width: min(700px, 100%); }
.modal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
.pager { display: flex; justify-content: space-between; align-items: center; margin-top: .9rem; }

/* Picker */
.picker { position: relative; }
.picker-list { list-style: none; margin: 0; padding: .25rem; border: 1px solid var(--line); border-radius: 8px; max-height: 190px; overflow-y: auto; background: var(--surface); }
.picker-list li { padding: .3rem .5rem; }
.picker-list button { all: unset; cursor: pointer; display: block; width: 100%; padding: .3rem .4rem; border-radius: 6px; }
.picker-list button:hover { background: var(--green-100); }
.picked { display: flex; justify-content: space-between; align-items: center; gap: .6rem; padding: .35rem .6rem; border: 1px solid var(--green-600); border-radius: 8px; background: var(--green-100); }

/* Login */
.auth-page { min-height: 100vh; min-height: 100dvh; display: grid; place-items: center; padding: 1rem; background: radial-gradient(circle at 20% 10%, var(--green-100), transparent 55%), var(--bg); }
.auth-card { width: min(420px, 100%); }
.auth-card .brand { color: var(--green-800); padding: 0; margin-bottom: 1rem; }
.auth-card .brand small { color: var(--muted); }
.code-box { font-family: ui-monospace, monospace; font-size: 1.7rem; letter-spacing: .15em; text-align: center; padding: 1rem; background: var(--ochre-100); border-radius: 10px; margin: .8rem 0; }
.kv { display: grid; grid-template-columns: max-content 1fr; gap: .35rem 1rem; font-size: .92rem; }
.kv dt { color: var(--muted); }
.kv dd { margin: 0; }
.tabs { display: flex; gap: .3rem; margin-bottom: 1rem; border-bottom: 1px solid var(--line); }
.tabs button { background: none; border: 0; padding: .6rem 1rem; cursor: pointer; font: inherit; color: var(--muted); border-bottom: 3px solid transparent; }
.tabs button.on { color: var(--green-800); border-color: var(--ochre); font-weight: 600; }

/* Pages d'erreur (404, erreur d'affichage) */
.error-page { min-height: 100vh; min-height: 100dvh; display: grid; place-items: center; padding: 1rem; background: radial-gradient(circle at 20% 10%, var(--green-100), transparent 55%), var(--bg); }
.error-card { width: min(460px, 100%); text-align: center; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 2rem 1.5rem; }
.error-logo { width: 56px; height: 56px; }
.error-code { margin: .75rem 0 0; font-size: 3.5rem; font-weight: 800; line-height: 1; color: var(--ochre); }
.error-card h1 { margin: .5rem 0; font-size: 1.4rem; font-family: inherit; }
.error-actions { display: flex; flex-wrap: wrap; gap: .5rem; justify-content: center; margin-top: 1.25rem; }
.error-actions a.btn { text-decoration: none; }
.error-actions .secondary { background: transparent; color: var(--green-800); border: 1px solid var(--green-800); }
.error-path { flex-basis: 100%; overflow-wrap: anywhere; color: var(--muted); font-size: .85rem; }

/* Réseau, bandeau d'information et page de confidentialité */
.net-banner { position: fixed; top: 0; left: 0; right: 0; z-index: 1000; padding: .45rem 1rem; text-align: center; font-size: .9rem; background: var(--warn-100); color: var(--text); border-bottom: 1px solid var(--line); }
.net-banner .btn { margin-left: .6rem; padding: .15rem .6rem; }
.cookie-notice { position: fixed; z-index: 1000; left: 1rem; right: 1rem; bottom: 1rem; max-width: 560px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: .75rem; align-items: center; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: .9rem 1rem; box-shadow: 0 6px 24px rgba(0, 0, 0, .15); }
.cookie-notice p { margin: 0; flex: 1 1 260px; font-size: .9rem; }
.legal-page { min-height: 100vh; min-height: 100dvh; display: grid; place-items: start center; padding: 2rem 1rem; background: var(--bg); }
.legal-card { width: min(680px, 100%); }
.legal-card h1 { font-size: 1.4rem; font-family: inherit; }
.legal-card h2 { font-size: 1.05rem; margin-top: 1.5rem; }

/* Logo Baobab */
.auth-logo { display: flex; flex-direction: column; align-items: center; gap: .4rem; margin-bottom: 1rem; }
.auth-logo img { width: 128px; height: 128px; border-radius: 22px; box-shadow: 0 6px 18px rgba(22, 58, 43, .25); }
.auth-logo small { font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
.brand img { border-radius: 8px; }
.error-logo { border-radius: 12px; }

/* === Liens sans soulignement === */
a { text-decoration: none; }
a.btn, a.btn:hover, a.btn:focus, a.btn:active { text-decoration: none; }
a.btn { display: inline-block; text-align: center; }
p a:hover, td a:hover, .muted a:hover, .legal-card a:hover { text-decoration: underline; }

/* === Connexion en deux colonnes (lot 2) === */
@keyframes auth-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
.auth-split > form { animation: auth-in .55s ease both; }
@media (prefers-reduced-motion: reduce) { .auth-split > form { animation: none; } }
@media (min-width: 900px) {
  .auth-split { grid-template-columns: minmax(380px, 42%) 1fr; padding: 0; background: var(--bg); }
  .auth-split > form { grid-column: 1; grid-row: 1; margin: 2rem auto; max-width: calc(100% - 3rem); }
  .auth-split::after { content: ''; grid-column: 2; grid-row: 1; align-self: stretch; justify-self: stretch; min-height: 100vh; min-height: 100dvh; background: #14352b url('/images/baobab-arbre.webp') center 35% / cover no-repeat; }
}
@media (max-width: 899px) {
  .auth-split { align-content: start; grid-template-rows: 210px auto; padding: 0 0 2rem; background: var(--bg); }
  .auth-split::before { content: ''; grid-row: 1; justify-self: stretch; height: 210px; background: #14352b url('/images/baobab-grove.webp') 50% 60% / cover no-repeat; border-radius: 0 0 28px 28px; }
  .auth-split > form { grid-row: 2; margin-top: -1.6rem; position: relative; max-width: calc(100% - 2rem); }
}
/* === Bandeaux photo (lot photos) === */
.banner { position: relative; overflow: hidden; border-radius: 16px; margin-bottom: 1.4rem; color: #fff; background: #14352b var(--banner-img) var(--banner-pos, center) / cover no-repeat; box-shadow: 0 10px 28px rgba(22, 58, 43, .14); }
.banner::before { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(12, 34, 24, .82) 0%, rgba(12, 34, 24, .5) 52%, rgba(12, 34, 24, .1) 100%); }
.banner-in { position: relative; display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; flex-wrap: wrap; min-height: 150px; padding: clamp(1.2rem, 3.5vw, 2rem) clamp(1rem, 3vw, 1.8rem); }
.banner h1 { color: #fff; text-shadow: 0 1px 8px rgba(0, 0, 0, .25); }
.banner .banner-sub { margin: .25rem 0 0; color: rgba(255, 255, 255, .88); font-size: .95rem; }
.banner .btn-ghost { color: #fff; border-color: rgba(255, 255, 255, .55); }
@media (max-width: 720px) {
  .banner { border-radius: 14px; }
  .banner::before { background: linear-gradient(0deg, rgba(12, 34, 24, .86) 0%, rgba(12, 34, 24, .3) 100%); }
  .banner-in { min-height: 124px; }
}

/* >>> baobab-ui-v2 (genere par Update-BaobabUi.ps1, ne pas modifier a la main) >>> */
/* Palette Baobab v2 : vert foret, ocre dore, creme chaud. Clair, sombre, ou choix de l'utilisateur. */
:root {
  color-scheme: light dark;
  --bg: #f6f3ea; --surface: #fffdf7; --text: #1f2a22; --muted: #5f695c; --line: #e3dcc9;
  --green-900: #123a2c; --green-800: #1b5a43; --green-600: #1f7d58; --green-100: #e2f0e8;
  --ochre: #d99a2b; --ochre-100: #fbf0d9;
  --bad: #b3372b; --bad-100: #f9e1dd; --warn-100: #fbefcf; --info: #25628f; --info-100: #dcebf6;
  --sage: #e5ecdf; --sage-600: #8aa58f; --wood: #8a5a35; --ivory: #fffdf7;
  --cream: #f4efe2; --on-ochre: #1d1608; --ochre-light: #f1c27a;
  --side-hover: #21503c; --side-line: #2c5a45; --side-field: #0f2a1f;
  --link: #1f7d58; --accent-text: #1b5a43; --warn-text: #8a5a00; --info-text: #6d4a10;
  --focus: var(--ochre);
  --r-sm: 8px; --r-md: 12px; --r-lg: 16px; --r-xl: 24px; --r-pill: 999px;
  --shadow-sm: 0 2px 8px rgba(22, 58, 43, .08);
  --shadow-md: 0 10px 28px rgba(22, 58, 43, .14);
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #101913; --surface: #18221b; --text: #e8ece4; --muted: #a3ad9d; --line: #2a382e;
    --green-900: #0c1a12; --green-800: #2a7f5a; --green-600: #4aa57c; --green-100: #20352a;
    --ochre: #e0a53a; --ochre-100: #3a2e18;
    --bad: #ff9a8c; --bad-100: #3d1f1b; --warn-100: #3a3016; --info: #7cb8e8; --info-100: #1b3243;
    --sage: #1c2a21; --ivory: #19221c; --wood: #c9955f;
    --link: #6fc49a; --accent-text: #6fc49a; --warn-text: #f0c36b; --info-text: #e8bd7a;
    --shadow-sm: 0 2px 8px rgba(0, 0, 0, .3); --shadow-md: 0 10px 28px rgba(0, 0, 0, .4);
  }
}
:root[data-theme="light"] { color-scheme: light; }
:root[data-theme="dark"] {
  color-scheme: dark;
    --bg: #101913; --surface: #18221b; --text: #e8ece4; --muted: #a3ad9d; --line: #2a382e;
    --green-900: #0c1a12; --green-800: #2a7f5a; --green-600: #4aa57c; --green-100: #20352a;
    --ochre: #e0a53a; --ochre-100: #3a2e18;
    --bad: #ff9a8c; --bad-100: #3d1f1b; --warn-100: #3a3016; --info: #7cb8e8; --info-100: #1b3243;
    --sage: #1c2a21; --ivory: #19221c; --wood: #c9955f;
    --link: #6fc49a; --accent-text: #6fc49a; --warn-text: #f0c36b; --info-text: #e8bd7a;
    --shadow-sm: 0 2px 8px rgba(0, 0, 0, .3); --shadow-md: 0 10px 28px rgba(0, 0, 0, .4);
}

/* Accessibilite : focus clavier visible partout */
:where(a, button, input, select, textarea, summary, [tabindex]):focus-visible {
  outline: 3px solid var(--focus);
  outline-offset: 2px;
}
.picker-list button:focus-visible { outline: 2px solid var(--link); outline-offset: -2px; background: var(--green-100); }
.modal:focus { outline: none; }

/* Liens : couleur + soulignement dans les textes (pas seulement la couleur) */
a { color: var(--link); }
:where(p, li, .legal-card, .muted) a:not([class]) {
  text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px;
}
.btn-ghost { color: var(--link); }

/* Couleurs de texte qui suivent le theme */
.stat .num, .tabs button.on, .subnav a.active, .avail.yes, .auth-card .brand,
.badge-ok, .alert-ok { color: var(--accent-text); }
.error-actions .secondary { color: var(--accent-text); border-color: var(--accent-text); }
.badge-warn { color: var(--warn-text); }
.alert-info { color: var(--info-text); }
.alert-error { color: var(--bad); }

/* Boutons : transitions et etats */
.btn, .btn-ghost, .icon-btn, .nav a, .topnav a, .subnav a, .tabs button {
  transition: background-color .15s, color .15s, border-color .15s, filter .15s, transform .1s;
}
.btn:active:not(:disabled) { transform: translateY(1px); filter: brightness(.95); }
.btn-ghost:hover:not(:disabled) { background: var(--green-100); filter: none; }
.sidebar .btn-ghost:hover:not(:disabled),
.topbar .btn-ghost:hover:not(:disabled),
.mobile-bar .btn-ghost:hover:not(:disabled) { background: rgba(255, 255, 255, .12); }
.icon-btn:hover { color: var(--text); }

/* Cartes de la bibliotheque (application lecteur) */
.book-card, .lib-card { transition: transform .2s ease, box-shadow .2s ease; }
.book-card:hover, .lib-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }

/* Tableaux : ombres de defilement horizontal (visibles seulement quand ca deborde) */
.table-wrap {
  background:
    linear-gradient(to right, var(--surface) 30%, transparent) 0 0 / 28px 100% no-repeat local,
    linear-gradient(to left, var(--surface) 30%, transparent) 100% 0 / 28px 100% no-repeat local,
    radial-gradient(farthest-side at 0 50%, rgba(0, 0, 0, .2), transparent) 0 0 / 12px 100% no-repeat scroll,
    radial-gradient(farthest-side at 100% 50%, rgba(0, 0, 0, .2), transparent) 100% 0 / 12px 100% no-repeat scroll,
    var(--surface);
}

/* Fenetres : apparition douce, pas de defilement qui traverse */
@keyframes ui-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes ui-pop  { from { opacity: 0; transform: translateY(8px) scale(.98); } to { opacity: 1; transform: none; } }
@keyframes ui-spin { to { transform: rotate(360deg); } }
.modal-backdrop { animation: ui-fade .15s ease both; }
.modal { animation: ui-pop .18s ease both; overscroll-behavior: contain; max-height: 90vh; max-height: 90dvh; box-shadow: var(--shadow-md); }

/* Etat vide et chargement */
.empty { border: 1px dashed var(--line); border-radius: var(--radius); }
.loading { display: flex; align-items: center; gap: .5rem; }
.spinner { display: inline-block; flex: none; width: 1.1rem; height: 1.1rem; border: 2px solid var(--line); border-top-color: var(--green-600); border-radius: 50%; animation: ui-spin .7s linear infinite; }

/* Zones de securite (encoche, barre d'accueil iOS) */
.net-banner { padding-top: calc(.45rem + env(safe-area-inset-top)); }
.cookie-notice { bottom: calc(1rem + env(safe-area-inset-bottom)); }

/* Champ mot de passe : Afficher / Masquer */
.pw-field { position: relative; display: flex; }
.pw-field input { flex: 1; min-width: 0; padding-right: 5.4rem; }
.pw-toggle { position: absolute; right: .3rem; top: 50%; transform: translateY(-50%); background: none; border: 0; border-radius: 6px; padding: .35rem .55rem; font: inherit; font-size: .82rem; font-weight: 600; color: var(--link); cursor: pointer; }
.pw-toggle:hover { background: var(--green-100); }
.caps-hint { color: var(--warn-text); }

/* Pages de connexion */
.auth-help { margin-top: .9rem; font-size: .9rem; }
.auth-help summary { cursor: pointer; color: var(--link); }
.auth-help p { margin: .5rem 0 0; }
.auth-foot { text-align: center; margin: 1rem 0 0; font-size: .85rem; }

/* Page d'erreur */
.error-card { box-shadow: var(--shadow-md); }
.error-help { margin: 1.4rem 0 0; font-size: .82rem; }

/* Politique de confidentialite */
.legal-card { width: min(780px, 100%); }
.legal-top { margin: 0 0 1rem; }
.legal-card section { scroll-margin-top: 1rem; }
.legal-toc { background: var(--green-100); border-radius: var(--radius); padding: .8rem 1rem; margin: 1rem 0 .5rem; }
.legal-toc ol { margin: .4rem 0 0; padding-left: 1.3rem; columns: 2 220px; column-gap: 1.5rem; }
.legal-toc li { margin: .15rem 0; break-inside: avoid; }
.legal-summary { background: var(--ochre-100); border-radius: var(--radius); padding: .8rem 1rem .8rem 2rem; }
.legal-summary li { margin: .3rem 0; }
.legal-actions { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.6rem; }
.legal-card table { width: 100%; border-collapse: collapse; font-size: .9rem; }
.legal-card th, .legal-card td { text-align: left; padding: .5rem .6rem; border-bottom: 1px solid var(--line); vertical-align: top; }
.legal-card th { color: var(--muted); font-weight: 600; }
@media print {
  .legal-actions, .legal-top, .legal-toc, .cookie-notice, .net-banner { display: none !important; }
  .legal-page { padding: 0; background: #fff; }
  .legal-card { border: 0; box-shadow: none; color: #000; }
}

/* Page Compte / Parametres */
.settings-grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); align-items: start; }
.settings-grid h2 { margin-bottom: .7rem; }
.settings-actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .8rem; }
.settings-note { margin-top: .8rem; }
.theme-choices { display: grid; gap: .5rem; }
.theme-choice { display: flex; gap: .7rem; align-items: flex-start; padding: .65rem .8rem; border: 1px solid var(--line); border-radius: var(--r-md); cursor: pointer; }
.theme-choice.on { border-color: var(--green-600); background: var(--green-100); }
.theme-choice input { margin-top: .3rem; accent-color: var(--green-600); }
.theme-choice > span { display: flex; flex-direction: column; }
.theme-choice:focus-within { outline: 3px solid var(--focus); outline-offset: 2px; }
.sidebar-foot .foot-link { display: inline-block; margin: .35rem 0; color: #dbe6de; }
.sidebar-foot .foot-link:hover, .sidebar-foot .foot-link.active { color: #fff; }
.sidebar-foot .foot-link.active { font-weight: 700; }
